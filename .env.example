# Sarvam AI API Configuration
SARVAM_API_KEY=
SARVAM_MODEL=Sarvam-105B

# Request rate limiting & retry behavior
SARVAM_REQUEST_DELAY=1.5
SARVAM_MAX_RETRIES=4
SARVAM_TIMEOUT=180

# Local Ollama / Qwen3 Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT=180

# Curriculum Improver Continuous Engine
MAX_SARVAM_CALLS_PER_CYCLE=2
MAX_SARVAM_CALLS_PER_HOUR=30
MAX_GENERATIONS_PER_CYCLE=3
SLEEP_BETWEEN_CYCLES=3.0
LAYA_DATA_DIR=data/learner

# Git Checkpoint Configuration (optional)
AUTO_GIT_PUSH=false
GIT_CHECKPOINT_INTERVAL=5
